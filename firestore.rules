rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerAluno(alunoId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.alunoId == alunoId;
    }

    // ---------- USERS ----------
    // Cada pessoa só enxerga o próprio perfil (para saber se é admin ou aluno).
    // Listar/gerenciar todos os usuários é só do admin.
    match /users/{uid} {
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'aluno');
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---------- ALUNOS ----------
    // O aluno só consegue LER o próprio cadastro (busca direta pelo ID salvo
    // em users/{uid}.alunoId) — nunca uma listagem/consulta da coleção
    // inteira; isso é reservado ao admin. A criação continua liberada no
    // autocadastro (senão o cadastro público de alunos para de funcionar).
    // Editar, excluir ou listar todos os alunos é só do admin.
    match /alunos/{alunoId} {
      allow get:    if isAdmin() || isOwnerAluno(alunoId);
      allow list:   if isAdmin();
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- INSTRUTORES ----------
    // Leitura pública é necessária para a página de agendamento (sem login)
    // mostrar os instrutores disponíveis. Só o admin cadastra/edita/remove.
    match /instrutores/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---------- VEÍCULOS ----------
    match /veiculos/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---------- AGENDAMENTOS ----------
    // Leitura pública (para ver horários livres) e criação pública
    // (formulário de agendamento, sem login) continuam liberadas — é o
    // coração do sistema. Alterar status, editar ou excluir é só do admin.
    match /agendamentos/{id} {
      allow read:           if true;
      allow create:         if true;
      allow update, delete: if isAdmin();
    }

    // ---------- AVISOS ----------
    // Qualquer pessoa logada (aluno ou admin) pode ler o mural de avisos.
    // Só o admin publica/edita/remove avisos.
    match /avisos/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- PAGAMENTOS / FINANCEIRO ----------
    // 100% restrito ao admin — nenhum outro perfil lê ou grava aqui.
    match /pagamentos/{id} {
      allow read, write: if isAdmin();
    }
  }
}
