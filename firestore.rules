rules_version = '2';

// ============================================================
// REGRAS DE SEGURANÇA DO FIRESTORE — Autoescola Rota Certa
// Cole este conteúdo em: Firebase Console > Firestore Database > Regras
//
// Modelo de acesso:
// - "users/{uid}"      -> perfil (admin | aluno), somente leitura do próprio doc
// - "alunos/{id}"       -> admin: tudo. aluno: leitura/edição apenas do próprio doc (uid == auth.uid)
// - "instrutores/{id}"  -> leitura pública (necessária no agendamento), escrita só admin
// - "veiculos/{id}"     -> leitura pública, escrita só admin
// - "agendamentos/{id}" -> criação pública (agendamento online sem login),
//                           leitura/edição/exclusão só admin ou o próprio aluno (por cpf)
// - "avisos/{id}"       -> leitura pública (autenticado), escrita só admin
// - "pagamentos/{id}"   -> somente admin
// ============================================================

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
}

function isOwnerAluno(alunoId) {
  return isSignedIn() &&
    exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.alunoId == alunoId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Um usuário pode criar seu PRÓPRIO doc apenas com role "aluno" (o app nunca envia "admin" no signup público).
      // Isso impede que alguém se autopromova a administrador pelo cliente.
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'aluno');
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /alunos/{alunoId} {
      allow read: if isAdmin() || isOwnerAluno(alunoId);
      allow create: if isAdmin() || isSignedIn(); // permite auto-cadastro no signup
      allow update: if isAdmin() || isOwnerAluno(alunoId);
      allow delete: if isAdmin();
    }

    match /instrutores/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /veiculos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /agendamentos/{id} {
      allow create: if true; // agendamento online público
      allow read: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /avisos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /pagamentos/{id} {
      allow read, write: if isAdmin();
    }
  }
}
